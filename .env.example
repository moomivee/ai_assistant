# Local Ollama with an OpenAI-compatible endpoint; 'local' is a placeholder, not a paid API key.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local
LLM_MODEL=qwen2.5:3b
LLM_MAX_TOKENS=2400
AGENT_MODE=loop
AGENT_MAX_STEPS=6
# Consecutive attempts without new evidence, after the first executed attempt.
AGENT_NO_PROGRESS_LIMIT=2
# Cooperative total deadline; each outbound timeout is capped by time remaining.
AGENT_TIMEOUT_SECONDS=180
# Reserve within the total budget for an evidence-based answer (not extra time).
AGENT_ANSWER_RESERVE_SECONDS=60
# Experimental ablation only; same-model self-review is not an independent quality gate.
ANSWER_SELF_REVIEW=false
HTTP_TIMEOUT=120
# Optional separate wait for LLM generation (CPU may need more time; maximum 600).
# LLM_HTTP_TIMEOUT=600
# Used by compose.local.yaml. For native Ollama set context in the app/server; see docs/Setup.md.
OLLAMA_CONTEXT_LENGTH=8192

# Optional Tavily. Without it, only the bundled EIA/CBR RSS fallback is available.
TAVILY_API_KEY=
WEB_DOMAINS=eia.gov,fred.stlouisfed.org,opec.org,iea.org,cbr.ru,economy.gov.ru,minfin.gov.ru,minenergo.gov.ru,reuters.com,interfax.ru,consilium.europa.eu,ofac.treasury.gov
NEWS_MAX_DAYS=30

# Available: minilm-multi, e5-small; pinned revisions and checksums are in src/rag/embedders.json.
RAG_EMBEDDING=minilm-multi
RAG_TOP_K=6
# dense remains the measured default; hybrid is an experimental BM25/RRF comparison.
RAG_SEARCH_MODE=dense
BACKTEST_ORIGINS=48
# DATA_DIR=/absolute/path/to/data
# CACHE_DIR=/absolute/path/to/cache
PORT=8000
LOG_LEVEL=INFO

# Content is excluded by default. Enable only when intentionally collecting review/eval examples.
TRACE_FILE=.cache/traces/agent.jsonl
TRACE_CONTENT=false
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
PROMPT_SOURCE=local
PROMPT_LABEL=production

# Optional independent evaluator; absent variables fall back to the main LLM.
# JUDGE_BASE_URL=http://localhost:11434/v1
# JUDGE_API_KEY=local
# JUDGE_MODEL=qwen2.5:7b
